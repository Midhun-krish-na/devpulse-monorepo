# DevPulse/.gitignore

# ==========================================
# Python / Django / DRF
# ==========================================

# Virtual Environment
env/
venv/
.venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Django database
db.sqlite3
db.sqlite3-journal

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log

# Static & media files
staticfiles/
media/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# ==========================================
# React / Node.js
# ==========================================

# Dependencies
node_modules/

# Build folders
dist/
build/

# Frontend environment files
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# IDE / Editor
# ==========================================

.vscode/
.idea/

# ==========================================
# OS Files
# ==========================================

.DS_Store
Thumbs.db

# ==========================================
# Misc
# ==========================================

*.swp
*.swo